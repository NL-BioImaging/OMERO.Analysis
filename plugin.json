{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "omero-analysis",
  "version": "0.15.0",
  "description": "Portable authoring skills for Analysis Methods, Pipelines, Notebooks, movies, and generic measurements.",
  "author": {
    "name": "NL-BioImaging",
    "url": "https://github.com/NL-BioImaging"
  },
  "homepage": "https://github.com/NL-BioImaging/OMERO.Analysis",
  "repository": "https://github.com/NL-BioImaging/OMERO.Analysis",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "omero",
    "jupyter",
    "notebook",
    "duckdb",
    "sqlite",
    "csv"
  ],
  "extensions": {
    "nl.bioimaging.biomero": {
      "skills": {
        "create-omero-analysis-notebook": {
          "purpose": "notebook-authoring",
          "consumers": [
            "omero-analysis"
          ],
          "auto_activate": false,
          "required_resources": [
            "references/PROTOCOL.md",
            "references/CONVERSION.md"
          ],
          "preferred_capabilities": [
            "omero-data-query-v1"
          ]
        },
        "create-omero-analysis-method": {
          "purpose": "method-authoring",
          "consumers": [
            "omero-analysis"
          ],
          "auto_activate": false
        },
        "create-omero-analysis-pipeline": {
          "purpose": "pipeline-authoring",
          "consumers": [
            "omero-analysis"
          ],
          "auto_activate": false
        },
        "create-omero-analysis-movie": {
          "purpose": "movie-authoring",
          "consumers": [
            "omero-analysis"
          ],
          "auto_activate": false
        },
        "analyze-tabular-measurements": {
          "purpose": "attachment-analysis",
          "consumers": [
            "omero-analysis"
          ],
          "auto_activate": true
        }
      }
    }
  }
}
