# Append to roles/docker/templates/web_conf.omero.j2.
config append -- omero.web.apps '"omero_analysis_chat"'
config append -- omero.web.ui.center_plugins '["Analysis Chat", "omero_analysis_chat/center_plugin.js.html", "omero_analysis_chat_panel"]'
config append -- omero.web.ui.top_links '["Analysis Chat", "omero_analysis_chat_index", {"title": "Open browser-local Analysis Chat", "target": "new"}]'
config set -- omero.web.analysis_chat.context_ttl_seconds 10800
config set -- omero.web.analysis_chat.max_upload_bytes 268435456
config set -- omero.web.analysis_chat.max_download_bytes 268435456
config set -- omero.web.analysis_chat.allowed_result_extensions '.csv,.tsv,.json,.xlsx,.xls,.parquet,.npy,.npz,.duckdb,.sqlite,.sqlite3,.png,.svg,.pdf,.txt,.md'

