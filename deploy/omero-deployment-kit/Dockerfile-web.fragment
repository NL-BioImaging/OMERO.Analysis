# Add after FROM and before `omero web syncmedia`.
USER root
COPY omero_analysis-*.whl /tmp/
COPY 49-omero-analysis-cleanup.py /startup/49-omero-analysis-cleanup.py
RUN /opt/omero/web/venv3/bin/python -m pip install --no-deps \
        /tmp/omero_analysis-*.whl \
    && rm -f /tmp/omero_analysis-*.whl \
    && chmod 0755 /startup/49-omero-analysis-cleanup.py
USER omero-web
